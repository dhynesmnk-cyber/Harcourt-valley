# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The anon key is safe to expose in client-side code by design — it's
# what Row Level Security policies (see supabase/schema.sql) are for.
# Never put the service_role key here or anywhere in this repo.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
