# Copy to .env.local for local dev, and set the same two in Netlify
# (Site settings → Environment variables) for the deployed site.
#
# Leave both unset and the app runs in demo mode: seeded data in localStorage,
# exactly as it behaved before there was a backend. Nothing breaks.
#
# Both of these are public by design — they ship in the browser bundle. What
# keeps data safe is Row Level Security in the database, not these values.
# Never put the service_role key here; it belongs only in function secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
